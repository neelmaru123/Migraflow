# ==============================================================================
# Migraflow Platform - Environment Configuration Template (.env)
# Copy this file to '.env' and populate your production secrets.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Migraflow API"
ENVIRONMENT="production"               # "production" or "development"
LOG_LEVEL="INFO"
JWT_SECRET_KEY="generate_a_random_32_character_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_STR="/api/v1"

# EC2 Public IP or Custom Domain
# Set your EC2 Public IP (e.g. 54.210.12.34) or domain name.
# Leave blank to enable dynamic browser host detection.
HOST_IP=""

# Frontend & Backend Network Endpoints
# If HOST_IP is left blank, frontend auto-detects browser hostname on port 8000.
# NEXT_PUBLIC_API_URL="http://54.210.12.34:8000/api/v1"
# NEXT_PUBLIC_WS_URL="ws://54.210.12.34:8000/api/v1"
FRONTEND_URL="http://localhost:3000"

# CORS Configuration
# Comma-separated allowed origins. Include your EC2 IP / domain, or '*' for permissive matching:
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,*"

# PostgreSQL Database (Docker Compose Internal)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_change_me"
POSTGRES_DB="migration_platform"

# AI Reasoning Engine Configuration
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.5-flash-lite"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=360.0

# Optional LangSmith AI Observability
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="migraflow-platform"

# Cloud Execution Capacity Limits
MAX_CLOUD_ROWS=500000
MAX_CLOUD_SIZE_MB=100.0

# Optional Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
