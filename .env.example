# ==============================================================================
# Migraflow Platform Environment Configuration Template
# Copy this file to '.env' and fill in your actual environment settings.
# DO NOT commit real API keys or secrets to version control.
# ==============================================================================

# LangChain / LangSmith AI Observability & Error Tracing
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langchain_api_key_here"
LANGCHAIN_PROJECT="Migraflow Platform"

LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="Migraflow Platform"

# Application Settings
PROJECT_NAME="Migraflow API"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="your_secret_key_change_in_production"
JWT_SECRET_KEY="your_jwt_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_STR="/api/v1"

# Application Control Plane Database (PostgreSQL)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="migration_platform"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5434
DATABASE_URL="postgresql+asyncpg://postgres:your_postgres_password@localhost:5434/migration_platform"

# Redis Queue & Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# AI Reasoning Engine Configuration
LLM_PROVIDER="gemini"                 # Supported: "gemini" or "openai"
LLM_MODEL="gemini-3.6-flash"          # e.g. "gemini-3.6-flash" or "gpt-4o"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=360.0

# Cloud Execution Capacity Limits
MAX_CLOUD_ROWS=500000
MAX_CLOUD_SIZE_MB=100.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
